# 完整說明見 docs/deployment.md

# ── 基本 ──
APP_URL=http://localhost:3000
DATABASE_PATH=./data/yuehao.db
# 可進營運後台 /admin 的帳號（逗號分隔；該帳號需完成信箱驗證）
ADMIN_EMAILS=
# 顯示在服務條款與隱私權政策的營運者名稱與客服信箱
OPERATOR_NAME=
SUPPORT_EMAIL=

# ── 收款：綠界 ECPay 信用卡定期定額（台灣）。設了就以綠界收款 ──
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# 設 1 使用綠界測試環境（測試商店 3002607 / pwFHCqoQZGmho4w6 / EkRm7iFT261dpevs）
ECPAY_STAGE=

# ── 收款：Stripe（有海外公司時；未設綠界才會生效） ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# 都沒設時：開發環境自動進入示範模式（不收款直接切換方案）。正式環境不要設這個
DEMO_BILLING=

# ── 寄信（Resend）。未設定時信件只寫進資料庫的 mail_log ──
RESEND_API_KEY=
MAIL_FROM=約好 <noreply@你的網域>

# ── 流量與維運 ──
# 反向代理放真實用戶 IP 的標頭（Fly: fly-client-ip、Cloudflare: cf-connecting-ip）
CLIENT_IP_HEADER=
# 每個 IP 每分鐘可呼叫公開 API 的次數
API_RATE_PER_MINUTE=120
# 每日備份保留份數
BACKUP_KEEP=7
# 異地備份（.github/workflows/backup.yml）與外部排程用的密鑰
CRON_SECRET=
# 改用外部排程呼叫 /api/cron/reminders 時設 1
DISABLE_INTERNAL_CRON=
# 設 off 關閉首頁的示範後台入口
DEMO_ENABLED=
