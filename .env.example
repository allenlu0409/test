# 網站對外網址（用於 Stripe 回跳、分享連結）
APP_URL=http://localhost:3000

# SQLite 檔案位置（正式環境請掛載持久化磁碟）
DATABASE_PATH=./data/yuehao.db

# ── Stripe 訂閱金流（未設定時，開發環境自動進入「示範模式」） ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# 正式環境若仍想開放「示範升級」（不收款直接切換方案）設為 1，僅供展示用
DEMO_BILLING=

# ── Email 通知（Resend）。未設定時信件只會記錄在資料庫的 mail_log，不會真的寄出 ──
RESEND_API_KEY=
MAIL_FROM=約好 <noreply@你的網域>

# 外部排程呼叫 /api/cron/reminders 用的密鑰（單機部署不需要，內建排程會處理）
CRON_SECRET=
DISABLE_INTERNAL_CRON=

# 反向代理提供的真實用戶 IP 標頭（Fly: fly-client-ip、Cloudflare: cf-connecting-ip），用於限流
CLIENT_IP_HEADER=
